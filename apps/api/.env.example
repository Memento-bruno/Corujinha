# Copie para .env e preencha. NUNCA commite o .env.
NODE_ENV=development
PORT=3333

# Provedor de dados: "mock" (dados fictícios, não precisa de conta) ou "pluggy"
FINANCE_PROVIDER=mock
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=

# "one_shot": revoga o consentimento logo após baixar as faturas (mais seguro, pede reconexão todo mês)
# "keep": mantém o consentimento até ele expirar ou ser revogado (sincroniza sozinho)
CONSENT_MODE=one_shot

# Autenticação: JWKS do provedor de login (ex.: Supabase Auth)
AUTH_JWKS_URL=
AUTH_ISSUER=
AUTH_AUDIENCE=authenticated
# IDs (claim "sub") das DUAS únicas pessoas que podem usar o app, separados por vírgula
ALLOWED_USER_IDS=

# Só em desenvolvimento: aceita "Authorization: Bearer <DEV_AUTH_TOKEN>:<userId>"
DEV_AUTH_TOKEN=
