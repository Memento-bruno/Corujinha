# Copie para apps/web/.env.local e preencha. NUNCA faça commit do .env.local.
# Sem nada preenchido, o app roda em MODO DEMO (sem login, dados fictícios locais).

# --- Login Google (Auth.js v5) -------------------------------------------------
# Gere com: openssl rand -base64 32
AUTH_SECRET=
# URL pública do app (em dev: http://localhost:3000)
AUTH_URL=http://localhost:3000
# Google Cloud Console > APIs e serviços > Credenciais > ID do cliente OAuth 2.0 (Aplicativo da Web)
# URIs de redirecionamento autorizados:
#   http://localhost:3000/api/auth/callback/google   (login)
#   http://localhost:3000/api/drive/callback         (assistente do refresh token do Drive)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Somente estes 2 e-mails conseguem entrar. EMAIL_1 = Pessoa A, EMAIL_2 = Pessoa B.
ALLOWED_USER_EMAIL_1=
ALLOWED_USER_EMAIL_2=

# --- Banco de dados no Google Drive -------------------------------------------
# ID da pasta compartilhada (o trecho depois de /folders/ na URL do Drive)
GOOGLE_DRIVE_FOLDER_ID=
# Criptografia AES-256-GCM dos JSONs (obrigatória com Drive). Gere com: openssl rand -base64 32
# Guarde em lugar seguro: sem ela os dados não podem ser lidos.
ENCRYPTION_SECRET=
# Como o servidor fala com o Drive:
#   oauth_refresh_token (recomendado p/ Gmail): faça login no app e abra /api/drive/connect
#   service_account: só funciona com Drive compartilhado do Google Workspace
GOOGLE_DRIVE_AUTH_MODE=oauth_refresh_token
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Cole a private_key do JSON, entre aspas, com os \n literais
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# --- Fallback local -------------------------------------------------------------
# Pasta onde os JSONs ficam quando o Drive não está configurado (padrão: .data)
# LOCAL_DATA_DIR=.data

# --- Open Finance via Meu Pluggy (opcional) ----------------------------------------
# dashboard.pluggy.ai → sua aplicação → Client ID / Client Secret. Só leitura: o app
# usa apenas contas de cartão, transações e faturas. O secret nunca sai do servidor.
# Depois de conectar o MeuPluggy, cadastre o Item ID em Ajustes → Open Finance.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
